# Copy to .env and fill in values

NODE_ENV=development
PORT=3000

USE_POSTGRES=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms_starter

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SUPER_ADMIN_USERNAME=superadmin
# Quote passwords that contain # $ @ or spaces
SUPER_ADMIN_PASSWORD="change-me-super"
# Super Admin can change both passwords in Modules. Hashes are stored in
# data/admin-credentials.json and override the env values above.
SESSION_SECRET=change-this-to-a-long-random-string

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend (preferred for enquiry + consultation emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=
ADMIN_EMAIL=
ADMIN_CC_EMAIL=
# Consultation form uses RESEND_TO_EMAIL / ADMIN_EMAIL as the inbox

# Optional: auto-detect landing page sections from uploaded UI designs
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
